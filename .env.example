# Copy to .env and fill in. .env is git-ignored.
# The NVR's address (IP or host name) on your network.
NVR_HOST=192.168.1.64
NVR_USER=admin
NVR_PASS=changeme

# The host name you will open in the browser (the nginx site from
# deploy/install-nginx.sh). Point it at this machine in DNS; it needs a TLS
# certificate (the installer makes a key and a signing request for you).
PROXY_DOMAIN=nvr.example.lan

# Optional: only used if channel auto-detection fails.
NVR_CHANNELS=8

# 1 (default) = the NVR's "Video Encryption" is on: streams are decrypted by
# hikdecrypt.py. It also passes unencrypted streams through, so 1 is safe either way.
NVR_ENCRYPTED=1
# Optional: the encryption key (the device's verification code), if it isn't NVR_PASS.
#NVR_KEY=

# Optional: 1 = also offer an H.264 re-encode of each main stream (chN_main_h264).
# Needed only if your browser can't play H.265 main streams. Costs CPU.
NVR_TRANSCODE=0
